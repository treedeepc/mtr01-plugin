        },
        "target": {
          "kind": "fixedLayoutField",
          "variable": "deviceInfo",
          "messageId": "bDeviceInfo",
          "fieldId": "serialNumber"
        },
        "control": "ascii",
        "maxBytes": 32
      },
      {
        "id": "softwareVersion",
        "label": "Software Version",
        "localizedLabels": {
          "zh-Hans": "软件版本",
          "zh-Hant": "軟體版本"
        },
        "target": {
          "kind": "fixedLayoutField",
          "variable": "deviceInfo",
          "messageId": "bDeviceInfo",
          "fieldId": "softwareVersion"
        },
        "control": "ascii",
        "maxBytes": 6
