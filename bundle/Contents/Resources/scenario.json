          {"value": 1, "label": "ATN-"},
          {"value": 2, "label": "ATN@"},
          {"value": 3, "label": "JBD"},
          {"value": 4, "label": "JK"},
          {"value": 5, "label": "YY"}
        ]
      },
      {
        "id": "batteryType",
        "label": "Battery Type",
        "localizedLabels": {
          "zh-Hans": "电池种类",
          "zh-Hant": "電池種類"
        },
        "target": {
          "kind": "fixedLayoutField",
