          {"value": 2, "label": "Lithium iron phosphate", "localizedLabels": {"zh-Hans": "磷酸铁锂", "zh-Hant": "磷酸鐵鋰"}},
          {"value": 3, "label": "Lead acid", "localizedLabels": {"zh-Hans": "铅酸", "zh-Hant": "鉛酸"}}
        ]
      },
      {
        "id": "baudRate",
