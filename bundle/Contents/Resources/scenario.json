        "label": "Hardware Version",
        "localizedLabels": {
          "zh-Hans": "硬件版本",
          "zh-Hant": "硬體版本"
        },
        "target": {
          "kind": "fixedLayoutField",
          "variable": "deviceInfo",
          "messageId": "bDeviceInfo",
          "fieldId": "hardwareVersion"
        },
        "control": "ascii",
        "maxBytes": 5
      },
      {
        "id": "bmsType",
        "label": "BMS Type",
        "localizedLabels": {
          "zh-Hans": "BMS 型号",
          "zh-Hant": "BMS 型號"
        },
        "target": {
          "kind": "fixedLayoutField",
          "variable": "deviceInfo",
