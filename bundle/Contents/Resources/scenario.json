      {
        "id": "temperaturesDeciCelsius",
        "label": "Cell Temperatures",
        "localizedLabels": {
          "zh-Hans": "电芯温度",
          "zh-Hant": "電芯溫度"
        },
        "target": {
          "kind": "fixedLayoutField",
          "variable": "report",
