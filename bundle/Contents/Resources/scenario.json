{
  "schemaVersion": 1,
  "scenarioId": "mtr01-sim",
  "name": "MTR01 Simulator",
  "protocolId": "mtr01-protocol",
  "protocolVersion": "1.5.1",
  "initialState": {
    "subscribed": false,
    "report": {
      "kind": "bytes",
      "hex": "40014001400140014001400140014001400140014001400140014001400140014001400140014001400140014001400140014001400140014001400140014001fa00fb00fc00fd003e0157002885ffc0ff01004101d0070100"
    },
    "localReport": {
      "kind": "bytes",
      "hex": "40014001400140014001400140014001400140014001400140014001400140014001400140014001400140014001400140014001400140014001400140014001fa00fb00fc00fd003e0157002885ffc0ff01004101d0070100"
    },
    "bmsTwinReport": {
      "kind": "bytes",
      "hex": "40014001400140014001400140014001400140014001400140014001400140014001400140014001400140014001400140014001400140014001400140014001fa00fb00fc00fd003e0157002885ffc0ff01004101d0070200"
    },
    "configured": false,
    "configuredBmsType": 0,
    "configuredBatteryType": 0,
    "configuredBaudRate": 0,
    "configuredVehicleProtocol": "",
    "configuredVehicleBrand": "",
    "runtimeRatedCapacity10mAh": 2000,
    "runtimeCellCount": 16,
    "runtimeConsumptionWhPer100km": 2500,
    "runtimeOcvRaw": {
      "kind": "bytes",
      "hex": "efefefefefefefefefefefefefefefefefefefefefefefefefefefefefefefefefefefefefefefefefef"
    },
    "connectionMode": 0,
    "connectedAddressType": 0,
    "connectedAddress": {
      "kind": "bytes",
      "hex": "efefefefefef"
    },
    "connected": false,
    "bound": false,
    "deviceInfo": {
      "kind": "bytes",
      "hex": "00efef4d5452303153494defefefefefefefefefefefefefefefefef424d5332303236313130353030303153572d312e35ef48572d31030101c2005253efef4e4955d00710c409efefefefefefefefefefefefefefefefefefefefefefefefefefefefefefefefefefefefefefefefefef"
    },
    "basicFeedback": {
      "kind": "bytes",
      "hex": "0100"
    },
    "runtimeFeedback": {
      "kind": "bytes",
      "hex": "0200"
    },
    "identityFeedback": {
      "kind": "bytes",
      "hex": "0300"
    },
    "connectionFeedback": {
      "kind": "bytes",
      "hex": "0201"
    },
    "scanList": {
      "kind": "bytes",
      "hex": ""
    },
    "bindingResponse": {
      "kind": "bytes",
      "hex": "0001"
    }
  },
  "rules": [
    {
      "id": "subscribe",
      "messageId": "aSubscribe",
      "actions": [
        {
          "kind": "set",
          "variable": "subscribed",
          "value": {
            "kind": "literal",
            "value": true
          }
        },
        {
          "kind": "send",
          "messageId": "aData",
          "values": {
            "payload": {
              "kind": "variable",
              "name": "report"
            }
          }
        }
      ]
    },
    {
      "id": "unsubscribe",
      "messageId": "aUnsubscribe",
      "actions": [
        {
          "kind": "set",
          "variable": "subscribed",
          "value": {
            "kind": "literal",
            "value": false
          }
        }
      ]
    },
    {
      "id": "read-once",
      "messageId": "aOnce",
      "actions": [
        {
          "kind": "send",
          "messageId": "aData",
          "values": {
            "payload": {
              "kind": "variable",
              "name": "report"
            }
          }
        }
      ]
    },
    {
      "id": "get-device-info",
      "messageId": "bGetInfo",
      "actions": [
        {
          "kind": "send",
          "messageId": "bDeviceInfo",
          "values": {
            "payload": {
              "kind": "variable",
              "name": "deviceInfo"
            }
          }
        }
      ]
    },
    {
      "id": "apply-identity-config",
      "messageId": "bIdentityConfig",
      "actions": [
        {
          "kind": "send",
          "messageId": "bIdentityConfigFeedback",
          "values": {
            "payload": {
              "kind": "variable",
              "name": "identityFeedback"
            }
          }
        }
      ]
    },
    {
      "id": "scan-devices",
      "messageId": "cScanRequest",
      "actions": [
        {
          "kind": "send",
          "messageId": "cScanList",
          "values": {
            "payload": {
              "kind": "variable",
              "name": "scanList"
            }
          }
        }
      ]
    },
    {
      "id": "binding-unbound",
      "messageId": "dUnbound",
      "actions": [
        {
          "kind": "send",
          "messageId": "dResponse",
          "values": {
            "payload": {
              "kind": "variable",
              "name": "bindingResponse"
            }
          }
        }
      ]
    },
    {
      "id": "binding-bound",
      "messageId": "dBound",
      "actions": [
        {
          "kind": "send",
          "messageId": "dResponse",
          "values": {
            "payload": {
              "kind": "variable",
              "name": "bindingResponse"
            }
          }
        }
      ]
    }
  ],
  "timers": [
    {
      "id": "realtime-report",
      "everyMs": 500,
      "when": {
        "variable": "subscribed",
        "equals": true
      },
      "actions": [
        {
          "kind": "send",
          "messageId": "aData",
          "values": {
            "payload": {
              "kind": "variable",
              "name": "report"
            }
          }
        }
      ]
    }
  ],
  "deviceFunctions": {
    "schemaVersion": 1,
    "functions": [
      {
        "id": "configureBms",
        "label": "Configure BMS",
        "localizedLabels": {
          "zh-Hans": "配置 BMS",
          "zh-Hant": "配置 BMS"
        },
        "trigger": {
          "messageId": "bBasicConfig",
          "when": []
        },
        "bind": [
          {
            "from": "bmsType",
            "to": "configuredBmsType",
            "editableFieldId": "bmsType"
          },
          {
            "from": "batteryType",
            "to": "configuredBatteryType",
            "editableFieldId": "batteryType"
          },
          {
            "from": "baudRate",
            "to": "configuredBaudRate",
            "editableFieldId": "baudRate"
          },
          {
            "from": "vehicleProtocol",
            "to": "configuredVehicleProtocol",
            "editableFieldId": "vehicleProtocol"
          },
          {
            "from": "vehicleBrand",
            "to": "configuredVehicleBrand",
            "editableFieldId": "vehicleBrand"
          }
        ],
        "actions": [
          {
            "kind": "set",
            "variable": "configured",
            "value": {"kind": "literal", "value": true}
          },
          {
            "kind": "send",
            "messageId": "bBasicConfigFeedback",
            "values": {
              "payload": {"kind": "variable", "name": "basicFeedback"}
            }
          }
        ]
      },
      {
        "id": "configureRuntime",
        "label": "Configure runtime parameters",
        "localizedLabels": {
          "zh-Hans": "配置运行参数",
          "zh-Hant": "配置執行參數"
        },
        "trigger": {
          "messageId": "bRuntimeConfig",
          "when": []
        },
        "bind": [
          {
            "from": "ratedCapacity10mAh",
            "to": "runtimeRatedCapacity10mAh",
            "editableFieldId": "deviceRatedCapacity10mAh"
          },
          {
            "from": "cellCount",
            "to": "runtimeCellCount",
            "editableFieldId": "cellCount"
          },
          {
            "from": "consumptionWhPer100km",
            "to": "runtimeConsumptionWhPer100km",
            "editableFieldId": "consumptionWhPer100km"
          },
          {
            "from": "ocvRaw",
            "to": "runtimeOcvRaw",
            "editableFieldId": "ocvRaw"
          }
        ],
        "actions": [
          {
            "kind": "send",
            "messageId": "bRuntimeConfigFeedback",
            "values": {
              "payload": {"kind": "variable", "name": "runtimeFeedback"}
            }
          }
        ]
      },
      {
        "id": "connectOnceBms",
        "label": "Connect BMS once",
        "localizedLabels": {
          "zh-Hans": "即时连接 BMS",
          "zh-Hant": "即時連接 BMS"
        },
        "trigger": {
          "messageId": "cConnectControl",
          "when": [{"field": "control", "oneOf": [1]}]
        },
        "enabledWhen": {
          "variable": "configured",
          "equals": true
        },
        "bind": [
          {"from": "control", "to": "connectionMode"},
          {"from": "addressType", "to": "connectedAddressType"},
          {"from": "address", "to": "connectedAddress"}
        ],
        "actions": [
          {
            "kind": "set",
            "variable": "connected",
            "value": {"kind": "literal", "value": true}
          },
          {
            "kind": "set",
            "variable": "bound",
            "value": {"kind": "literal", "value": false}
          },
          {
            "kind": "set",
            "variable": "report",
            "value": {"kind": "variable", "name": "bmsTwinReport"}
          },
          {
            "kind": "send",
            "messageId": "cConnectionFeedback",
            "values": {
              "payload": {"kind": "variable", "name": "connectionFeedback"}
            }
          }
        ]
      },
      {
        "id": "bindAndConnectBms",
        "label": "Bind and connect BMS",
        "localizedLabels": {
          "zh-Hans": "绑定并连接 BMS",
          "zh-Hant": "綁定並連接 BMS"
        },
        "trigger": {
          "messageId": "cConnectControl",
          "when": [{"field": "control", "oneOf": [2]}]
        },
        "enabledWhen": {
          "variable": "configured",
          "equals": true
        },
        "bind": [
          {"from": "control", "to": "connectionMode"},
          {"from": "addressType", "to": "connectedAddressType"},
          {"from": "address", "to": "connectedAddress"}
        ],
        "actions": [
          {
            "kind": "set",
            "variable": "connected",
            "value": {"kind": "literal", "value": true}
          },
          {
            "kind": "set",
            "variable": "bound",
            "value": {"kind": "literal", "value": true}
          },
          {
            "kind": "set",
            "variable": "report",
            "value": {"kind": "variable", "name": "bmsTwinReport"}
          },
          {
            "kind": "send",
            "messageId": "cConnectionFeedback",
            "values": {
              "payload": {"kind": "variable", "name": "connectionFeedback"}
            }
          }
        ]
      },
      {
        "id": "disconnectBms",
        "label": "Disconnect BMS",
        "localizedLabels": {
          "zh-Hans": "断开并解绑 BMS",
          "zh-Hant": "斷開並解綁 BMS"
        },
        "trigger": {
          "messageId": "cDisconnectAndUnbind",
          "when": []
        },
        "actions": [
          {
            "kind": "set",
            "variable": "connected",
            "value": {"kind": "literal", "value": false}
          },
          {
            "kind": "set",
            "variable": "bound",
            "value": {"kind": "literal", "value": false}
          },
          {
            "kind": "set",
            "variable": "report",
            "value": {"kind": "variable", "name": "localReport"}
          }
        ]
      }
    ]
  },
  "editableFields": {
    "schemaVersion": 1,
    "fields": [
      {
