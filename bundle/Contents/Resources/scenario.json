        "options": [
          {"value": 0, "label": "Idle", "localizedLabels": {"zh-Hans": "未放电", "zh-Hant": "未放電"}},
          {"value": 1, "label": "Discharging", "localizedLabels": {"zh-Hans": "放电中", "zh-Hant": "放電中"}}
        ]
      },
      {
        "id": "chargeState",
        "label": "Charge State",
        "localizedLabels": {
          "zh-Hans": "充电状态",
          "zh-Hant": "充電狀態"
        },
        "target": {
          "kind": "fixedLayoutField",
          "variable": "report",
          "messageId": "aData",
          "fieldId": "chargeState"
        },
        "control": "enum",
        "minimum": 0,
        "maximum": 1,
        "step": 1,
        "options": [
          {"value": 0, "label": "Idle", "localizedLabels": {"zh-Hans": "未充电", "zh-Hant": "未充電"}},
          {"value": 1, "label": "Charging", "localizedLabels": {"zh-Hans": "充电中", "zh-Hant": "充電中"}}
        ]
      },
      {
        "id": "ratedCapacity10mAh",
        "label": "Rated Capacity",
        "localizedLabels": {
          "zh-Hans": "额定容量",
          "zh-Hant": "額定容量"
        },
        "target": {
          "kind": "fixedLayoutField",
          "variable": "report",
          "messageId": "aData",
