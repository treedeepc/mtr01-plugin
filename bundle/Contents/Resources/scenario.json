        "control": "hexBytes",
        "bytes": 8
      },
      {
        "id": "dischargeState",
        "label": "Discharge State",
        "localizedLabels": {
          "zh-Hans": "放电状态",
          "zh-Hant": "放電狀態"
        },
        "target": {
          "kind": "fixedLayoutField",
          "variable": "report",
          "messageId": "aData",
          "fieldId": "dischargeState"
        },
        "control": "enum",
        "minimum": 0,
